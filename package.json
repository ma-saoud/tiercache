{
  "name": "tiercache",
  "version": "1.0.0",
  "description": "Lightweight multi-tier cache for TypeScript/Node.js. Chain in-memory, Redis or disk stores behind one async API, with automatic backfill to faster tiers and per-key TTL.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "in-memory",
    "typescript",
    "cache",
    "tiered",
    "ram",
    "memory",
    "cache-manager",
    "saoud",
    "redis",
    "postgres"
  ],
  "author": "Mohamed Amine Saoud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ma-saoud/tiercache.git"
  },
  "bugs": {
    "url": "https://github.com/ma-saoud/tiercache/issues"
  },
  "homepage": "https://github.com/ma-saoud/tiercache#readme",
  "scripts": {
    "clean": "rm -rf dist node_modules && git clean -fdx",
    "fclean": "pnpm clean && rm -rf package-lock.json pnpm-lock.yaml",
    "build": "tsc",
    "test": "vitest run ",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
