{
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "clean": "rm -rf dist node_modules && git clean -fdx",
    "fclean": "pnpm clean && rm -rf package-lock.json pnpm-lock.yaml",
    "dev": "tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "build": "pnpm tsc",
    "test": "vitest run ",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
